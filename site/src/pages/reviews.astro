---
import BaseLayout from '../layouts/BaseLayout.astro';
import CallToAction from '../components/CallToAction.astro';
import { BUSINESS, hasReviewProof } from '../data/business';
import { REVIEWS, REVIEWS_READ_ON } from '../data/reviews';
const readOn = new Date(`${REVIEWS_READ_ON}T12:00:00Z`).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
import { title, description } from '../lib/seo';
const path = '/reviews/';
---
<BaseLayout
  title={title('Reviews of Blouin Pest Services')}
  description={description('What Blouin Pest Services customers say, with the Google rating and the date it was read. No review text is reproduced without the customer’s own words.')}
  path={path}
  crumbs={[{ name: 'Reviews', item: path }]}
>
  <h1>Reviews</h1>
  {hasReviewProof() && (
    <div class="answer">
      <p>
        <strong>{BUSINESS.reviews.rating.toFixed(1)} out of 5, from {BUSINESS.reviews.count} Google reviews.</strong>
        Read from the {BUSINESS.reviews.source} on {BUSINESS.reviews.observed}. That figure moves, and this page is updated when it does.
      </p>
    </div>
  )}
  <p>
    Reviews are published here as text — readable by people, by search engines and by answer engines — rather than inside a widget
    that crawlers cannot read. Each one appears word for word with the reviewer's first name and the month (or the year, where
    Google says only "a year ago"), exactly as it stands on the Google Business Profile. Nothing is written, edited or summarised on a customer's behalf, and the figure above is re-read
    from the profile rather than typed once and left to go stale.
  </p>
  <h2 id="quoted">What customers wrote</h2>
  <p>
    {REVIEWS.length} of the reviews, chosen because each one names the pest and what happened, checked against the profile on
    {readOn}. Spelling and punctuation are the customer's own.
  </p>
  <div class="reviews">
    {REVIEWS.map((r) => (
      <figure class="review">
        <p class="review-meta">
          <span class="stars" aria-label={`${r.stars} out of 5 stars`}>{'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}</span>
          <span class="pests">{r.pests.join(' · ')}</span>
        </p>
        <blockquote><p>{r.text}</p></blockquote>
        <figcaption>{r.name}, {r.month} · Google</figcaption>
        {r.reply && <p class="review-reply"><strong>Ryan replied:</strong> {r.reply}</p>}
      </figure>
    ))}
  </div>
  {BUSINESS.reviews.profileUrl && <p><a href={BUSINESS.reviews.profileUrl}>Read all the reviews on Google</a></p>}
  <h2>How we ask for reviews</h2>
  <ul>
    <li>We ask every customer once, after the work is finished.</li>
    <li>We do not offer discounts, credits or anything else in exchange for a review.</li>
    <li>We do not screen customers for a likely rating before asking.</li>
    <li>Nobody at Blouin Pest Services writes a review for a customer.</li>
  </ul>
  <CallToAction />
</BaseLayout>
