---
const { path = '/' } = Astro.props;
const on = (p: string) => (p === '/' ? path === '/' : path.startsWith(p)) ? 'page' : undefined;
const primary = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/service-area/', label: 'Service area' },
  { href: '/locations/', label: 'Towns' },
  { href: '/library/', label: 'Pest library' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const secondary = [
  { href: '/reviews/', label: 'Reviews' },
  { href: '/our-guarantee/', label: 'Our guarantee' },
  { href: '/compliance/maine-pesticide-licensing/', label: 'Licensing' },
];
---
<header class="site">
  <a class="banner" href="/">
    <img
      src="/brand/bps-banner-1440.webp"
      srcset="/brand/bps-banner-720.webp 720w, /brand/bps-banner-1440.webp 1440w, /brand/bps-banner-1920.webp 1920w"
      sizes="(min-width: 960px) 960px, 100vw"
      width="1440" height="481"
      alt="Blouin Pest Services"
      fetchpriority="high"
    />
  </a>
  <div class="wrap">
    <nav class="site" aria-label="Primary">
      <ul>
        {primary.filter((l) => l.href !== '/locations/').map((l) => (
          <li><a href={l.href} aria-current={on(l.href)}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <nav class="site secondary" aria-label="Secondary">
      <ul>
        {secondary.map((l) => <li><a href={l.href} aria-current={on(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
