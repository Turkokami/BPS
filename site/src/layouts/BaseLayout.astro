---
import '../styles/base.css';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { BUSINESS } from '../data/business';
import { coreNodes, webPageNode, graph } from '../lib/schema';
import { areaServed } from '../lib/geo';

interface Crumb { name: string; item: string }
interface Props {
  title: string; description: string; path: string;
  crumbs?: Crumb[]; extraNodes?: unknown[]; noindex?: boolean; ogType?: string;
}
const { title, description, path, crumbs = [], extraNodes = [], noindex = false, ogType = 'website' } = Astro.props as Props;
const canonical = `${BUSINESS.site}${path}`;
const core = coreNodes();
// areaServed is attached here so a page can never claim territory the demand map has not authorised.
(core[0] as Record<string, unknown>).areaServed = areaServed().map((a) => ({ '@type': 'AdministrativeArea', name: a }));
const nodes = [...core, ...webPageNode(path, title, description, [{ name: 'Home', item: '/' }, ...crumbs]), ...extraNodes];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={`${BUSINESS.site}/og-default.png`} />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={graph(nodes)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TopBar />
    <Header path={path} />
    {crumbs.length > 0 && (
      <nav class="wrap crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c) => <span> › <a href={c.item}>{c.name}</a></span>)}
      </nav>
    )}
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
